; 升格会的的冬日猜想 - Godot 4.7 .NET/C# UI vertical slice
; Core 与数据层由后续模块接入；当前主场景保持可独立启动。

config_version=5

[application]

config/name="升格会的的冬日猜想"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[dotnet]

project/assembly_name="SoudacheGodot"

[gui]

theme/default_font_multichannel_signed_distance_field=true
