+  expect(draw.getAttribute('aria-label')).toBe(draw.title);
+  expect(grave.getAttribute('aria-label')).toBe(grave.title);
+  for (const [uids, count] of [[before.drawPile, 2], [before.discard, 1], [before.grave, 1]]) {
