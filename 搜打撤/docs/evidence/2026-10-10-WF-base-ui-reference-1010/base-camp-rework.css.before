/* 基地六分区：稳定导航、物品浏览、人物展示与配置三类骨架。 */
#overlay #hubMain.pg.hub.base-camp {
  --camp-paper: #edf1f3; --camp-sheet: #fbfcfd; --camp-ink: #253945;
  --camp-sub: #526773; --camp-line: #cbd6dd; --camp-blue: #28798b;
  --camp-brass: #c7aa68;
}
#overlay #hubMain.pg.hub.base-camp .hub-body { grid-template-columns: 205px minmax(0, 1fr); }
#overlay #hubMain.pg.hub.base-camp .hub-head { min-height: 72px; padding: 14px 28px; }
#overlay #hubMain.pg.hub.base-camp .hub-tabs { padding: 26px 14px 20px; gap: 5px; }
#overlay #hubMain.pg.hub.base-camp .hub-tab { min-height: 70px; padding: 13px 12px; gap: 11px; }
#overlay #hubMain.pg.hub.base-camp .hub-tab .tab-txt b { font-size: 22px; }
#overlay #hubMain.pg.hub.base-camp .hub-tab .camp-nav-index { display: none; }
#overlay #hubMain.pg.hub.base-camp .hub-tab.on { background: #2d4b59; box-shadow: none; }
#overlay #hubMain.pg.hub.base-camp .hub-tab.on::before { background: #83c7d6; }
#overlay #hubMain.pg.hub.base-camp .hub-tab::after { display: none; }
#overlay #hubMain.pg.hub.base-camp .hub-tabs { position: relative; }
#overlay #hubMain.pg.hub.base-camp .hub-tab::before { display: none; }
#overlay #hubMain.pg.hub.base-camp .camp-navigation-indicator { position: absolute; left: 10px; top: 0; width: 3px; background: #83c7d6; pointer-events: none; transition: transform .22s cubic-bezier(.16,1,.3,1), height .22s; }
#overlay #hubMain.pg.hub.base-camp .hub-page { padding: 26px 32px 30px; background: var(--camp-paper); }
#overlay #hubMain.pg.hub.base-camp .camp-section-head { margin-bottom: 18px; gap: 6px; }
#overlay #hubMain.pg.hub.base-camp .camp-section-head h2 { font-size: 40px; }
#overlay #hubMain.pg.hub.base-camp .camp-section-head p { font-size: 21px; margin: 2px 0 0; }
#overlay #hubMain.pg.hub.base-camp .camp-section-head small { font-size: 16px; color: #57717e; }
#overlay #hubMain.pg.hub.base-camp .hub-page.page-in { animation-duration: .22s; }
#overlay #hubMain.pg.hub.base-camp .mini-btn { width: auto; min-height: 48px; font-size: 20px; padding: 9px 13px; }
#overlay #hubMain.pg.hub.base-camp :is(.stash-sections, .collection-tabs) { margin-bottom: 18px; }
#overlay #hubMain.pg.hub.base-camp :is(.stash-section-tab, .collection-tabs button) { font-size: 21px; }
#overlay #hubMain.pg.hub.base-camp [hidden] { display: none !important; }
/* 浏览型：网格与常驻详情。 */
#overlay #hubMain.pg.hub.base-camp .warehouse-toolbar {
  display: flex; align-items: center; gap: 10px; margin-bottom: 18px; flex-wrap: wrap;
}
#overlay #hubMain.pg.hub.base-camp .warehouse-toolbar :is(input, select) {
  font: 20px/1.4 var(--font-ui); color: var(--camp-ink); background: var(--camp-sheet);
  border: 1px solid var(--camp-line); border-radius: 2px; min-height: 48px; padding: 8px 12px;
}
#overlay #hubMain.pg.hub.base-camp .warehouse-search { display: flex; align-items: center; gap: 8px; flex: 1; max-width: 280px; }
#overlay #hubMain.pg.hub.base-camp .warehouse-search input { width: 100%; min-width: 100px; }
#overlay #hubMain.pg.hub.base-camp .warehouse-search > span { white-space: nowrap; font-size: 19px; }
#overlay #hubMain.pg.hub.base-camp .warehouse-toolbar > .mini-btn { flex: 0 0 auto; min-width: 78px; }
#overlay #hubMain.pg.hub.base-camp .warehouse-toolbar > span { margin-left: auto; color: var(--camp-sub); font-size: 19px; }
#overlay #hubMain.pg.hub.base-camp .warehouse-layout { display: grid; grid-template-columns: minmax(0, 1fr) 420px; align-items: start; gap: 24px; }
#overlay #hubMain.pg.hub.base-camp .warehouse-browser { min-width: 0; }
#overlay #hubMain.pg.hub.base-camp .warehouse-v2 .stash-cardgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(215px, 1fr)); gap: 18px; }
#overlay #hubMain.pg.hub.base-camp .warehouse-v2 .stash-cell { min-width: 0; width: 100%; max-width: 210px; padding: 6px; aspect-ratio: .71; background: #dfe8ed; border: 2px solid transparent; }
#overlay #hubMain.pg.hub.base-camp .warehouse-v2 .stash-cell .hs-card { width: 100%; height: 100%; font-size: 11px; }
#overlay #hubMain.pg.hub.base-camp .warehouse-v2 .stash-cell.selected { border-color: var(--camp-blue); box-shadow: 0 0 0 2px #28798b30; }
#overlay #hubMain.pg.hub.base-camp .warehouse-v2 .stack-count { bottom: auto; left: auto; height: auto; width: auto; border-radius: 2px; top: 10px; right: 10px; padding: 2px 5px; min-width: 24px; font-size: 19px; }
#overlay #hubMain.pg.hub.base-camp .warehouse-v2 .stash-cell:hover:not(:disabled) { transform: translateY(-3px); }
#overlay #hubMain.pg.hub.base-camp .warehouse-inspector { position: sticky; top: 0; box-sizing: border-box; min-width: 0; padding: 20px; background: var(--camp-sheet); border-left: 2px solid var(--camp-blue); overflow: auto; scrollbar-width: thin; }
#overlay #hubMain.pg.hub.base-camp .warehouse-detail-art { width: 190px; height: 272px; margin: 0 auto 18px; }
#overlay #hubMain.pg.hub.base-camp .warehouse-detail-art .hs-card { width: 100%; height: 100%; font-size: 10px; }
#overlay #hubMain.pg.hub.base-camp :is(.warehouse-inspector, .person-details) header small { font: 16px/1.5 var(--font-mono); color: var(--camp-sub); }
#overlay #hubMain.pg.hub.base-camp :is(.warehouse-inspector, .person-details, .facility-details) h3 { font: 700 34px/1.3 var(--font-ui); margin: 6px 0 16px; color: var(--camp-ink); }
#overlay #hubMain.pg.hub.base-camp .warehouse-description { font-size: 21px; line-height: 1.7; color: var(--camp-ink); }
#overlay #hubMain.pg.hub.base-camp .warehouse-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 16px 0; margin: 12px 0; border-top: 1px solid var(--camp-line); border-bottom: 1px solid var(--camp-line); }
#overlay #hubMain.pg.hub.base-camp .warehouse-facts dt { color: var(--camp-sub); font-size: 18px; }
#overlay #hubMain.pg.hub.base-camp .warehouse-facts dd { color: var(--camp-ink); font: 700 26px/1.6 var(--font-num); margin: 4px 0 0; }
#overlay #hubMain.pg.hub.base-camp .warehouse-operation-note { font-size: 19px; line-height: 1.7; color: var(--camp-sub); }
#overlay #hubMain.pg.hub.base-camp .warehouse-operations { display: flex; flex-wrap: wrap; gap: 8px; position: sticky; bottom: 0; background: var(--camp-sheet); padding: 8px 0; }
#overlay #hubMain.pg.hub.base-camp .warehouse-operations .mini-btn { flex: 1 1 auto; }
#overlay #hubMain.pg.hub.base-camp .warehouse-confirm { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--camp-line); }
#overlay #hubMain.pg.hub.base-camp .warehouse-confirm b { flex-basis: 100%; font-size: 20px; color: #a83c37; }
#overlay #hubMain.pg.hub.base-camp :is(.warehouse-idle, .warehouse-no-results) { padding: 70px 20px; text-align: center; color: var(--camp-sub); }
/* 人物展示型：头像导航、立绘、局部资料。 */
#overlay #hubMain.pg.hub.base-camp :is(.person-groups, .person-sections) { display: flex; gap: 8px; margin-bottom: 16px; }
#overlay #hubMain.pg.hub.base-camp :is(.person-groups, .person-sections) .mini-btn { flex: 0 0 auto; }
#overlay #hubMain.pg.hub.base-camp .person-sections .mini-btn { border: 0; background: transparent; color: var(--camp-sub); border-bottom: 2px solid transparent; }
#overlay #hubMain.pg.hub.base-camp .person-sections .mini-btn.ok { border-color: var(--camp-blue); color: var(--camp-blue); }
#overlay #hubMain.pg.hub.base-camp .person-stage { display: grid; grid-template-columns: 140px minmax(0, 1fr) 360px; gap: 20px; min-height: 570px; }
#overlay #hubMain.pg.hub.base-camp .person-roster { display: flex; flex-direction: column; gap: 10px; max-height: 680px; overflow: auto; scrollbar-width: thin; }
#overlay #hubMain.pg.hub.base-camp .person-face { display: flex; position: relative; align-items: center; flex-direction: column; min-height: 102px; padding: 8px; border: 1px solid var(--camp-line); background: var(--camp-sheet); color: var(--camp-ink); overflow: hidden; }
#overlay #hubMain.pg.hub.base-camp .person-face img { height: 64px; width: 100%; object-fit: cover; object-position: center 30%; }
#overlay #hubMain.pg.hub.base-camp .person-face b { font: 600 20px/1.4 var(--font-ui); }
#overlay #hubMain.pg.hub.base-camp .person-face small { font: 16px/1.5 var(--font-ui); color: var(--camp-sub); }
#overlay #hubMain.pg.hub.base-camp .person-face.on { border-color: var(--camp-blue); box-shadow: inset 3px 0 var(--camp-blue); background: #e2eef2; }
#overlay #hubMain.pg.hub.base-camp .person-hero { margin: 0; position: relative; overflow: hidden; min-height: 570px; background: #d5e1e7; }
#overlay #hubMain.pg.hub.base-camp .person-hero > img { width: 100%; height: 100%; position: absolute; object-fit: contain; object-position: center bottom; }
#overlay #hubMain.pg.hub.base-camp .person-hero[data-skin="default"] { background: #fff; }
#overlay #hubMain.pg.hub.base-camp .person-hero figcaption { position: absolute; inset: auto 0 0; padding: 24px; color: #f4f8fa; background: linear-gradient(transparent, #1c3745dd); }
#overlay #hubMain.pg.hub.base-camp .person-hero figcaption h3 { font-size: 42px; color: inherit; margin: 4px 0 8px; }
#overlay #hubMain.pg.hub.base-camp .person-hero figcaption small { font-size: 20px; }
#overlay #hubMain.pg.hub.base-camp .person-hero figcaption span { font-size: 20px; }
#overlay #hubMain.pg.hub.base-camp .person-stage .person-details { padding: 24px; border: 0; background: var(--camp-sheet); display: flex; flex-direction: column; gap: 10px; overflow: auto; max-height: 680px; }
#overlay #hubMain.pg.hub.base-camp .person-details section { padding-top: 15px; border-top: 1px solid var(--camp-line); }
#overlay #hubMain.pg.hub.base-camp .person-details h4 { font-size: 16px; margin: 0 0 10px; }
#overlay #hubMain.pg.hub.base-camp .person-details p { font-size: 21px; line-height: 1.7; }
#overlay #hubMain.pg.hub.base-camp .person-details .hint { font-size: 19px; }
#overlay #hubMain.pg.hub.base-camp .person-perk-value { color: var(--camp-blue); font-weight: 600; }
#overlay #hubMain.pg.hub.base-camp .person-skin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
#overlay #hubMain.pg.hub.base-camp .person-skin { display: flex; flex-direction: column; align-items: center; padding: 5px; border: 2px solid transparent; background: #e7edf0; color: var(--camp-ink); }
#overlay #hubMain.pg.hub.base-camp .person-skin.on { border-color: var(--camp-blue); }
#overlay #hubMain.pg.hub.base-camp .person-skin img { width: 100%; height: 110px; object-fit: cover; object-position: center 25%; }
#overlay #hubMain.pg.hub.base-camp .person-skin b { font-size: 19px; }
#overlay #hubMain.pg.hub.base-camp .person-skin small { font-size: 16px; }
#overlay #hubMain.pg.hub.base-camp .person-pool { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
#overlay #hubMain.pg.hub.base-camp .person-pool-card { border: 0; padding: 0; background: none; color: var(--camp-sub); }
#overlay #hubMain.pg.hub.base-camp .person-pool-card .hs-card { width: 100%; height: 190px; font-size: 9px; }
#overlay #hubMain.pg.hub.base-camp .person-pool-card > span { display: block; font-size: 18px; margin: 6px 0; }
#overlay #hubMain.pg.hub.base-camp .person-collection .coll-room { padding: 22px; }
#overlay #hubMain.pg.hub.base-camp .partner-display { background: radial-gradient(ellipse at 50% 40%, #e7f1f5, #c7d9e1); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 28px; }
#overlay #hubMain.pg.hub.base-camp .partner-emblem .ic { width: 170px; height: 170px; margin-bottom: 36px; }
#overlay #hubMain.pg.hub.base-camp .partner-display h3 { font-size: 36px; margin: 12px 0; }
#overlay #hubMain.pg.hub.base-camp .partner-display small { font-size: 16px; letter-spacing: .12em; color: var(--camp-sub); }
#overlay #hubMain.pg.hub.base-camp .partner-display p { font-size: 20px; }
#overlay #hubMain.pg.hub.base-camp .partner-state { margin-top: 20px; padding: 7px 20px; background: #286374; color: #f6fbfc; font-size: 20px; }
#overlay #hubMain.pg.hub.base-camp .partner-stage .person-face > span .ic { width: 36px; height: 36px; margin: 7px; }
/* 补给：短商品单元，四件商品完整陈列。 */
#overlay #hubMain.pg.hub.base-camp .camp-shop-layout { display: flex; flex-direction: column; gap: 22px; }
#overlay #hubMain.pg.hub.base-camp .camp-shop-intro { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; padding: 14px 20px; border: 0; background: #dce7ed; color: var(--camp-ink); }
#overlay #hubMain.pg.hub.base-camp .camp-shop-intro > p { flex: 1; max-width: none; font-size: 20px; margin: 0; color: var(--camp-sub); }
#overlay #hubMain.pg.hub.base-camp .camp-shop-intro > :is(.section-kicker, small) { display: none; }
#overlay #hubMain.pg.hub.base-camp .camp-reserve-value { display: flex; align-items: center; gap: 8px; margin: 0; }
#overlay #hubMain.pg.hub.base-camp .camp-reserve-value b { font-size: 28px; color: var(--camp-ink); }
#overlay #hubMain.pg.hub.base-camp .camp-reserve-value span { font-size: 20px; }
#overlay #hubMain.pg.hub.base-camp.hub-shop .camp-shop-intro :is(p, .base-line, .base-line b, .camp-reserve-value span, .mini-btn) { color: var(--camp-ink); }
#overlay #hubMain.pg.hub.base-camp .shop-shelf { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
#overlay #hubMain.pg.hub.base-camp .camp-product { padding: 16px; gap: 12px; background: var(--camp-sheet); }
#overlay #hubMain.pg.hub.base-camp .camp-product .shelf-visual { height: 225px; min-height: 0; display: flex; align-items: center; justify-content: center; background: #e3ebef; }
#overlay #hubMain.pg.hub.base-camp .camp-product .shelf-visual .hs-card { width: 145px; height: 207px; font-size: 10px; }
#overlay #hubMain.pg.hub.base-camp .camp-product .shelf-visual > .shelf-ico .ic { width: 66px; height: 66px; }
#overlay #hubMain.pg.hub.base-camp .camp-product .shelf-info b { font-size: 28px; }
#overlay #hubMain.pg.hub.base-camp .camp-product .shelf-info > .dim { font-size: 20px; min-height: 50px; }
#overlay #hubMain.pg.hub.base-camp .shop-price-tag { font-size: 16px; margin-top: auto; }
/* 建设：设施总览与明确的本次收益。 */
#overlay #hubMain.pg.hub.base-camp .facility-layout { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 28px; }
#overlay #hubMain.pg.hub.base-camp .facility-map { display: grid; grid-template-columns: 1fr 1fr; align-content: start; gap: 20px; }
#overlay #hubMain.pg.hub.base-camp .facility-tile { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: 30px; border: 2px solid transparent; background: #dce6eb; color: var(--camp-ink); text-align: left; }
#overlay #hubMain.pg.hub.base-camp .facility-tile.on { border-color: var(--camp-blue); background: #e3f0f4; }
#overlay #hubMain.pg.hub.base-camp .facility-glyph .ic { width: 66px; height: 66px; }
#overlay #hubMain.pg.hub.base-camp .facility-tile h3 { font-size: 24px; margin: 0; }
#overlay #hubMain.pg.hub.base-camp .facility-tile > small { font-size: 16px; letter-spacing: .1em; color: var(--camp-sub); }
#overlay #hubMain.pg.hub.base-camp .facility-tile > b { font: 700 48px/1.4 var(--font-num); }
#overlay #hubMain.pg.hub.base-camp .facility-tile b small { font-size: 16px; font-weight: 400; }
#overlay #hubMain.pg.hub.base-camp .facility-tile > span:last-child { font-size: 20px; }
#overlay #hubMain.pg.hub.base-camp .facility-track { height: 5px; width: 100%; background: #c6d7df; }
#overlay #hubMain.pg.hub.base-camp .facility-track i { display: block; height: 100%; background: var(--camp-blue); }
#overlay #hubMain.pg.hub.base-camp .facility-partners { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 15px; padding-top: 20px; font-size: 21px; }
#overlay #hubMain.pg.hub.base-camp .facility-details { padding: 28px; background: var(--camp-sheet); border-left: 2px solid var(--camp-blue); }
#overlay #hubMain.pg.hub.base-camp .facility-details > small { font-size: 16px; color: var(--camp-sub); }
#overlay #hubMain.pg.hub.base-camp .facility-details p { font-size: 21px; line-height: 1.7; }
#overlay #hubMain.pg.hub.base-camp .facility-benefit { margin-top: 30px; display: flex; flex-direction: column; gap: 12px; }
#overlay #hubMain.pg.hub.base-camp .facility-benefit > span { font-size: 20px; }
#overlay #hubMain.pg.hub.base-camp .facility-benefit b { font: 700 38px/1.5 var(--font-num); color: var(--camp-blue); }
#overlay #hubMain.pg.hub.base-camp .facility-benefit b span { font-size: 24px; font-weight: 400; }
#overlay #hubMain.pg.hub.base-camp .facility-benefit b small { font-size: 16px; }
#overlay #hubMain.pg.hub.base-camp .story-archive .story-strip { display: block; margin: 0; padding: 24px; font-size: 22px; line-height: 1.8; }
#overlay #hubMain.pg.hub.base-camp .ach-row { padding: 18px 20px; }
#overlay #hubMain.pg.hub.base-camp .ach-row.claimable { border-left: 3px solid var(--camp-blue); }
#overlay #hubMain.pg.hub.base-camp .camp-notice.warning { border-left-color: #dc8b7f; background: #653f3c; }
#overlay #hubMain.pg.hub.base-camp .archive-status { display: flex; gap: 8px; margin-bottom: 18px; }
#overlay #hubMain.pg.hub.base-camp .archive-backs-layout { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 26px; }
#overlay #hubMain.pg.hub.base-camp .archive-backs-layout .back-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
#overlay #hubMain.pg.hub.base-camp .archive-back-preview { padding: 24px; background: #e3edf2; }
#overlay #hubMain.pg.hub.base-camp .back-preview-art { position: relative; overflow: hidden; width: 210px; height: 301px; margin: 0 auto 18px; }
#overlay #hubMain.pg.hub.base-camp .back-preview-art > * { width: 100%; height: 100%; }
#overlay #hubMain.pg.hub.base-camp .archive-backs-layout .hs-back { pointer-events: none; }
/* 同一出征流程：可返回的步骤与草稿摘要。 */
#overlay #hubMain.pg.hub.base-camp .camp-draft { margin-top: 15px; padding: 13px 16px; background: #e0edf1; color: var(--camp-ink); font-size: 20px; }
#overlay .camp-steps { display: flex; align-items: center; gap: 12px; font: 20px/1.4 var(--font-ui); }
#overlay .camp-steps :is(button, b) { border: 0; padding: 7px 12px; background: transparent; color: #abc2cc; font: inherit; }
#overlay .camp-steps button { cursor: pointer; }
#overlay .camp-steps b { color: #f3f8fa; border-bottom: 2px solid #83c7d6; }
#overlay .cls2-page[data-base-departure="true"] > .camp-steps { position: absolute; z-index: 8; right: 25px; top: 24px; }
#overlay #depMain.camp-detail .hub-head .camp-steps { margin-left: auto; }
#overlay #depMain.camp-detail .dep-back-mode { font-size: 20px; margin-right: 16px; }
#overlay #depMain.camp-detail .camp-pack-note { color: #496675; }
#overlay #depMain.pg.hub.camp-detail.camp-depart-detail { background: #edf1f3; }
#overlay #depMain.pg.hub.camp-detail.camp-depart-detail .dep-body .hub-card { background: #fbfcfd; border-color: #cbd6dd; }
#overlay #depMain.pg.hub.camp-detail.camp-depart-detail .dep-foot { background: #dce7ed; }
#overlay #depMain.pg.hub.camp-detail.camp-depart-detail .camp-depart-person-copy .mini-btn { color: #f2f8fa; background: #365b6a; border-color: #718f9b; font-size: 18px; }
@media (max-width: 1050px) {
  #overlay #hubMain.pg.hub.base-camp .warehouse-layout { grid-template-columns: minmax(0, 1fr) 285px; gap: 16px; }
  #overlay #hubMain.pg.hub.base-camp .person-stage { grid-template-columns: 85px minmax(0, 1fr) 300px; gap: 12px; }
  #overlay #hubMain.pg.hub.base-camp .facility-layout { grid-template-columns: minmax(0, 1fr) 300px; }
}
@media (prefers-reduced-motion: reduce) {
  #overlay #hubMain.pg.hub.base-camp .hub-page { animation: none; }
}
