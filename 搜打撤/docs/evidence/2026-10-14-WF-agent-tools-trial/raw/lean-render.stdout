{"effective_response_profile":"compact","workflow":"implementation","fragments":[{"path":"game/tools/agent-batch.mjs","start_line":225,"end_line":227,"representation":"symbol","content":"win.requestAnimationFrame = (cb) => (typeof setImmediate === 'function'\n  ? setImmediate(() => { try { cb(performance.now()); } catch (e) { console.error('[raf]', e && (e.stack || e.message) || e); } })\n  : setTimeout(() => { try { cb(performance.now()); } catch (e) { console.error('[raf]', e && (e.stack || e.message) || e); } }, 0));\n","reason":"symbol; text"},{"path":"tests/e7-rule-warning-view.test.js","start_line":95,"end_line":95,"representation":"symbol","content":"  window.requestAnimationFrame = callback => { frames.push(callback); return frames.length; };\n","reason":"symbol; text"},{"path":"game/src/core/perf-probe.local.js","start_line":215,"end_line":234,"content":"        const tick = now => {\n          if (stopped) return;\n          try {\n            if (document.visibilityState !== 'visible') throw new Error('页面采样期间不可见');\n            if (isMapSample && !onIdleMap()) throw new Error('采样期间离开静止地图');\n            if (mode === 'page' && currentPageMechanism().signature !== pageStart.mechanismSignature) {\n              throw new Error('采样期间页面机制已变化');\n            }\n            if (previousFrame) gaps.push(now - previousFrame);\n            previousFrame = now;\n            if (mode === 'pan' && camera) {\n              camera.cx = previousCamera.cx + Math.sin((now - started) / 450) * 36;\n              camera.cy = previousCamera.cy + Math.cos((now - started) / 620) * 24;\n              camera.frameMode = 'manual';\n              renderScheduler.invalidate();\n            }\n            if (now - started < DURATION_MS) { frameId = requestAnimationFrame(tick); return; }\n            resolve(now);\n          } catch (error) { reject(error); }\n        };\n","reason":"text; reference"},{"path":"tests/e2-view-hp.test.js","start_line":89,"end_line":93,"content":"const or