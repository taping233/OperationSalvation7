{"effective_response_profile":"compact","workflow":"implementation","fragments":[{"path":"game/src/hub/base.js","start_line":161,"end_line":240,"target_start_line":183,"target_end_line":187,"representation":"focus_symbol","content":"      return true;\n    } catch {\n      // 写失败不再静默：仓库配额满时玩家以为卡牌已入库，重开档无声丢失。\n      // base.js 无 UI 静态导入，循 window.SDT 晚读惯例（同 rules()）\n      if (!saveWarned) {\n        saveWarned = true;\n        try { if (window.SDT && window.SDT.UI) window.SDT.UI.log('[[icon:cross]] 基地存档写入失败（存储空间可能已满），入库/升级可能未保存', 'warn'); } catch { /* 门面未就绪 */ }\n      }\n      return false;\n    }\n  }\n\n  // 普通游玩时间保持旧checkpoint策略：先推进Base内存，再尝试保存；失败由\n  // 命令结果显式标记，后续Base保存可落盘该值。此操作不属于跨档journal原子事务。\n  function persistPlaySeconds(next) {\n    data.stats.playSeconds = next;\n    if (!slot) return false;\n    return save();\n  }\n  const elapsedCommands = createBaseElapsedCommands({ read: () => data, persistPlaySeconds });\n\n  // 旧同步接口保留返回口径；所有资源变更先在草稿上完成，保存失败不污染运行态。\n  function mutate(prepare, failure = false) {\n    if (!slot) return failure;\n    const result = commitBaseMutation(data, prepare, save);\n    return result.ok ? result.value : failure;\n  }\n\n  // Pet-egg pity keeps its historical chest contract: a failed durable write\n  // still advances this one in-memory field while the already-rolled reward\n  // proceeds. This is explicitly not an atomic save and does not weaken mutate.\n  function persistEggPity(next) {\n    if (!slot) {\n      data.eggPity = next;\n      return false;\n    }\n    const saved = mutate(draft => { draft.eggPity = next; return true; }, false);\n    if (saved === true) return true;\n    // Legacy chests changed Base.data before calling save(); keep only that\n    // narrow in-memory fallback. Protected/too-new storage is never rewritten.\n    data.eggPity = next;\n    return false;\n  }\n  // 宠物蛋战斗计数（2026-09-29 收敛）：无档位胜利的原直写路径移入命令层，\n  // 沿用保底计数同款旧语义——先内存推进，落盘失败不回滚（persisted:false）。\n  function persistEggBattles(next) {\n    if (!slot) {\n      data.eggBattles = next;\n      return false;\n    }\n    const saved = mutate(draft => { draft.eggBattles = next; return true; }, false);\n    if (saved === true) return true;\n    data.eggBattles = next;\n    return false;\n  }\n  const petEggCommands = createBasePetEggCommands({ read: () => data, persistPity: persistEggPity, persistBattles: persistEggBattles });\n\n  // Meta 进度端口（2026-09-29 收敛）：战斗统计/熟练度/收藏回填的规则在草稿上准备，\n  // 保存成功才替换运行态；失败时同一规则在运行态补应用一次（仅内存推进，persisted:false）。\n  // 局内/战斗中调用频繁，与 elapsed/pet-egg 同属 checkpoint 旧语义家族。\n  function persistMetaProgress(prepare) {\n    if (!slot) return { value: prepare(data), persisted: false };\n    const result = commitBaseMutation(data, prepare, save);\n    if (result.ok) return { value: result.value, persisted: true };\n    return { value: prepare(data), persisted: false };\n  }\n  const metaCommands = createBaseMetaCommands({ read: () => data, persistProgress: persistMetaProgress });\n\n  // 「卡牌是消耗品」一次性教学旗（2026-09-29 收敛，原 game.bag.settle teachAmmoOnce 直写）。\n  // 旧语义：先内存推进再尝试保存——保存失败重试层依赖旗子只弹一次，故不做严格事务。\n  function markAmmoTaught() {\n    data.ammoTaught = true;\n    if (!slot) return false;\n    return save();\n  }\n\n  // 仓库收藏经验的容器兜底（原 meta.js onCollect 直改 data.collXp；仅内存初始化，\n  // 持久化随下一次命令保存，同 ensureStarterPet 惯例）。\n  function ensureCollXp() {\n    if (!data.collXp || typeof data.collXp !== 'object') data.collXp = {};\n","reason":"focus_symbol; text; reference; focus"},{"path":"game/src/hub/base-mutation.js","start_line":1,"end_line":41,"target_start_line":31,"target_end_line":41,"representation":"focus_symbol","content":"// @ts-check\nimport { clone } from '../core/shared.js';\n\n/** 保留未改变分支的引用，兼容调用方持有的仓库卡堆；修改分支仍是独立草稿。\n * @param {unknown} current @param {unknown} draft @returns {unknown}\n */\nfunction retainUnchanged(current, draft) {\n  if (current === draft) return current;\n  if (!current || !draft || typeof current !== 'object' || typeof draft !== 'object' ||\n      Array.isArray(current) !== Array.isArray(draft)) return draft;\n  const before = /** @type {Record<string, unknown>} */ (current);\n  const after = /** @type {Record<string, unknown>} */ (draft);\n  const keys = Object.keys(after);\n  let unchanged = keys.length === Object.keys(before).length;\n  for (const key of keys) {\n    after[key] = retainUnchanged(before[key], after[key]);\n    if (!Object.prototype.hasOwnProperty.call(before, key) || after[key] !== before[key]) unchanged = false;\n  }\n  return unchanged ? current : draft;\n}\n\n/**\n * 单键基地操作：只修改隔离草稿；持久化端口成功后才允许调用方报告成功。\n * 与带 requestId 的跨存档结算不同，本函数不重试、不发布事件、不拥有存档。\n * @template TState, TValue\n * @param {TState} current\n * @param {(draft: TState) => TValue} prepare\n * @param {(draft: TState) => boolean} persist\n * @returns {{ok: true, value: TValue} | {ok: false, code: 'SAVE_FAILED'}}\n */\nexport function commitBaseMutation(current, prepare, persist) {\n  const draft = clone(current);\n  const value = prepare(draft);\n  // 草稿不能跨异步边界：异步生产者可能在返回后继续改状态。\n  if (value && typeof value === 'object' && 'then' in value) {\n    throw new TypeError('Base mutations must be synchronous');\n  }\n  const prepared = /** @type {TState} */ (retainUnchanged(current, draft));\n  if (!persist(prepared)) return { ok: false, code: 'SAVE_FAILED' };\n  return { ok: true, value };\n}\n","reason":"focus_symbol; import; symbol; text; focus"}],"receipt":{"fragment_hashes":["84b5b723855f436aea413e44968827b5","6abe5ba73f4ef2eae06008f4f2454f6a"]},"omission_summary":{"path_excluded":163,"budget_or_result_limit":7},"coverage":{"focus_path_coverage":[{"pattern":"game/src/hub/base.js","indexed_paths":1,"minimum_fragments":1,"selected_fragments":1,"satisfied":true},{"pattern":"game/src/hub/base-mutation.js","indexed_paths":1,"minimum_fragments":1,"selected_fragments":1,"satisfied":true}],"path_scope_satisfied":true},"provenance":{"commit_revision":"3d02437e4c3c","branch":"master","working_tree_state":"modified","working_tree_paths_complete":false,"working_tree_p