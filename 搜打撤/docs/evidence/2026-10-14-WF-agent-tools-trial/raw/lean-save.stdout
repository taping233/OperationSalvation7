{"effective_response_profile":"compact","workflow":"implementation","fragments":[{"path":"game/src/hub/base-mutation.js","start_line":31,"end_line":41,"representation":"import_symbol","content":"export function commitBaseMutation(current, prepare, persist) {\n  const draft = clone(current);\n  const value = prepare(draft);\n  // 草稿不能跨异步边界：异步生产者可能在返回后继续改状态。\n  if (value && typeof value === 'object' && 'then' in value) {\n    throw new TypeError('Base mutations must be synchronous');\n  }\n  const prepared = /** @type {TState} */ (retainUnchanged(current, draft));\n  if (!persist(prepared)) return { ok: false, code: 'SAVE_FAILED' };\n  return { ok: true, value };\n}\n","reason":"import; symbol; text"},{"path":"tests/base-mutation.test.js","start_line":142,"end_line":146,"content":"    const state = { bag: { count: 2 } };\n    const persist = vi.fn(() => false);\n    expect(commitBaseMutation(state, draft => { draft.bag.count--; return 1; }, persist)).toEqual({ ok: false, code: 'SAVE_FAILED' });\n    expect(state.bag.count).toBe(2);\n    persist.mockClear();\n","reason":"text; reference"}],"receipt":{"fragment_hashes":["b977c3d44113aa137ce8d7852108613f","3694a4a5886c54bdc733abcb8aeb5578"]},"omission_summary":{"budget_or_result_limit":169},"provenance":{"commit_revision":"3d02437e4c3c","branch":"master","working_tree_state":"modified","working_tree_paths_complete":false,"working_tree_paths_limit":512,"repository_generation":1,"freshness":"current","status":"available"},"warnings":["169 omitted","working-tree path discovery is incomplete at 512 paths; advisory results may omit changed files"],"meta":{"repository_id":"a6683b9b65db0697973dd2c0e2d2fa47","repository_generation":1,"freshness":"current","index_scope":"scoped","index_scope_digest":"56e8c90f9bffe609","source_tokens":210,"protocol_tokens":129,"path_and_metadata_tokens":237,"total_response_tokens":576,"tokenizer":"o200k_base","token_count_exact":true,"receipt_id":"r799c8885eacd90d4e6dbf2b18264d60b0000000000000001"