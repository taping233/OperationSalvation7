on":"text; reference"},{"path":"game/src/agent/agent.state.js","start_line":364,"end_line":380,"representation":"symbol","content":"function settleSignature() {\r\n  const nowC = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();\r\n  if (nowC - sigCacheT < 1) return sigCacheV;\r\n  const prof = globalThis.__stepProf;\r\n  const t = prof ? performance.now() : 0;\r\n  const snap = game.battleActive && window.SDT?.Battle?.getSnapshot ? window.SDT.Battle.getSnapshot() : null;\r\n  const out = JSON.stringify([\r\n    game.state, game.battleActive, !!game.terminalPending, !!game.pendingExtraction,\r\n    game.turn, snap ? [snap.busy, snap.actionQueueLength, snap.phase, snap.hand.length, snap.foes.map(f => f.hp)] : null,\r\n    overlayVisible(),\r\n    collectActionKeys(),   // 轻量键扫描（无 label/textContent）——settle 轮询性能关键\r\n  ]);\r\n  if (prof) { prof.sigMs += performance.now() - t; prof.sigCalls += 1; }\r\n  sigCacheT = nowC;\r\n  sigCacheV = out;\r\n  return out;\r\n}\r\n","reason":"symbol"},{"path":"game/src/agent/agent.runner.js","start_line":301,"end_line":314,"content":"    res: { ok: false, id: res.id, code: 'CONTEXT_CHANGED', message: '命令交棒期间对局归属已改变' },\n    done: false, stopReason: 'context-changed' });\n  bustSigCache();   // 状态已被 act 改写：作废 before 写入的 TTL 缓存，首轮探测立即可见\n  if (res.code === 'COMMAND_TIMEOUT' || res.code === 'CONTEXT_CHANGED') {\n    return { obs: observe(), action: decision, id: res.id, res, done: false,\n      stopReason: res.code === 'COMMAND_TIMEOUT' ? 'command-timeout' : 'context-changed' };\n  }\n  if (!sameContext(settledContext)) return staleCommand();\n  const isWaitAction = decision?.type === 'sys' && decision?.name === 'noop';\n  if (res.ok && !isWaitAction) {\n    const deadline = nowMs() + (isTurbo() ? 40 : 1500);\n    const pl = prof;\n    let actPoll = 0;\n    let firstCheckMs = 0;\n","reason":"reference"},{"path":"game/src/agent/agent.state.js","start_line":303,"end_line":351,"representation":"symbol","content":"function observe() {\r\n  const prof = globalThis.__stepProf;\r\n  const tObs = prof ? performance.now() : 0;\r\n  const phase = phaseOf();\r\n  if (game.battleActive) warmBattleLookups();\r\n  const snap = game.battleActive && window.SDT?.Battle?.getSnapshot ? window.SDT.Battle.getSnapshot() : null;\r\n  const uiActions = collectUiActions();\r\n  const moveActions = phase === 'map' ? mapActions() : [];\r\n  const fightActions = phase === 'battle' ? battleActions(snap) : [];\r\n  const bagDrops = bagActions();\r\n  const sysActions = phase === 'title' ? [withId({ type: 'sys', name: 'startGame', label: '开始探索' })] : [];\r\n  // 背包满开包（09-26 断链修复①）：野外唯一腾格入口。bagBtnFloat 无 data-act 且在\r\n  // ovBody 外 surface 扫不到、showBackpack 只经 game.debug 暴露——协议补 openBackpack。\r\n  // 只在 map 相推（overlay 期间 showBackpack 会与现页叠层）；无可丢卡（全 safe/初始牌）不推，\r\n  // 否则开包后无 discardCard 可选会空转。phase==='map' 已蕴含 overlay 未开\r\n  if (phase === 'map' && game.runActive && !game.battleActive) {\r\n    const owned = game.ownedCards || [];\r\n    const discardable = owned.some(o => o.card && !o.safe && !o.stored && o.card.name !== '初始攻击');\r\n    // 满格=usedSlots>=cap（堆叠口径）：ownedCards.length 在多张同名时虚高，\r\n    // 曾致 11/16 就开包丢卡（seed77023 带出价值13→0 的回归根因）\r\n    if (usedSlots() >= bagCap() && discardable) {\r\n      sysActions.push(withId({ type: 'sys', name: 'openBackpack', label: `背包已满（${usedSlots()}/${bagCap()} 格）· 开包丢卡腾格` }));\r\n    }\r\n  }\r\n  const actions = [\r\n    ...uiActions.map(withId),\r\n    ...moveActions,\r\n    ...fightActions,\r\n    ...bagDrops,\r\n    ...sysActions,\r\n  ];\r\n  const out = {\r\n    ok: true,\r\n    settle: phase !== 'moving' && phase !== 'boot' && !(snap && (snap.busy || snap.actionQueueLength > 0)),\r\n    lastFailed: (uiFailure && Date.now() - uiFailure.ts < 3000) ? uiFailure.fail : null,\r\n    phase,\r\n    turn: game.turn ?? 0,\r\n    run: runBrief(),\r\n    battle: battleView(snap),\r\n    ui: {\r\n      open: overlayVisible(),\r\n      title: (document.getElementById('ovTitle')?.textContent || '').replace(/\\s+/g, ' ').trim().slice(0, 60),\r\n      actions: uiActions,\r\n    },\r\n    actions,\r\n  };\r\n  if (prof) { prof.obsMs += performance.now() - tObs; prof.obsCalls += 1; }\r\n  return out;\r\n}\r\n","reason":"symbol; text; reference"},{"path":"game/src/battle/battle.snapshot.types.d.ts","start_line":209,"end_line":213,"content":"    targetIndexes: readonly number[];\n    effectiveCost?: number;\n    legal?: boolean;\n    illegalReason?: string;\n    heartsMode?: boolean;\n","reason":"text"},{"path":"tests/map-travel-motion.test.js","start_line":100,"end_line":104,"content":"    expect(getMapTravelPresentation(harness.game)).toBeNull();\n  });\n  it('geometry invalidation releases the movement lock without committing an obsolete destination', () => {\n    const g = harness.game;\n    moveTo(0, 2); arrive();\n","reason":"text"}],"receipt":{"fragment_hashes":["45ef309c9a990980fe69b825c0850598","70485b028f15ba78a99c5b71b6f6c8c9","4400e1d3cd3154bec64329c95dd07da8","3eebad192c4569cc33be03bd6b3bedee","f7259f622288eb190643e29bd203e728","7f3619f920103803986082ef03966d27","2b94a4b6cad05979d3a30206b03a3215","6169ad9266c3d7bfbd4528f1c3ef7df9"]},"omission_summary":{"budget_or_result_limit":268},"provenance":{"commit_revision":"3d02437e4c3c","branch":"master","working_tree_state":"modified","working_tree_paths_complete":false,"working_tree_paths_limit":512,"repository_generation":1,"freshness":"current","status":"available"},"warnings":["268 omitted","working-tree path discovery is incomplete at 512 paths; advisory results may omit changed files"],"meta":{"repository_id":"a6683b9b65db0697973dd2c0e2d2fa47","repository_generation":1,"freshness":"current","index_scope":"scoped","index_scope_digest":"56e8c90f9bffe609","source_tokens":1778,"protocol_tokens":129,"path_and_metadata_tokens":735,"total_response_tokens":2642,"tokenizer":"o200k_base","token_count_exact":true,"receipt_id":"r799c8885eacd90d4e6dbf2b18264d60b000000000000