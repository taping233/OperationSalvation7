  "minimalPatchProposal": [
    "battle.frames.js定义冻结本地role→action→有序frame数组，或单独battle.frame-sequences.js仅源码清单；不是asset manifest改写。",
    "candidateNames(role)用动作定义展开唯一名字，loadSet按LOAD_BATCH=3保序加载，seqs以声明数组过滤成功项；保留重复字节的槽位，不去重时序。",
    "首补丁只换候选/序列构建；保留SEQ_MS idle2900/atk-wind320/atk-hit280/hurt420/cast800、demoMs、maxFPS30、随机idle相位。",
    "第二步待属地确认：battle.view.js:601 attachUnitFrames(body,{role: 当前snapshot角色id})，battle.frames.js优先显式role，旧src正则仅兼容回退；不从新资产路径推断角色。实际snapshot字段需在对应源码属地负责人核定。",
    "黑像/星月目前无帧目录继续静态；新角色资产验过透明/安全距/身份才追加动作清单。v1/v2小样失败不接runtime，静图transform不算补帧。"
  ],
  "preserve": [
    "lifecycle token每个await后和isLiveBattleFigure守卫",
    "同步隐藏static img与失败恢复，idle缺失卸载部分纹理",
    "hide清sprite EMPTY、等待releasePromise、evictOtherTextureSets与urls准确卸载",
    "同角色重render不重置play，单次动作回resumeAfter或idle，缺帧过滤/缺动作跳过",
    "hidden暂停/clock setPaused/减动效静图/静止rect轮询",
    "事件仍由anim.view卡牌起飞触发cast/atk，vfx触发hurt，battle.lifecycle session.abort/clearActionSignals与finish结果链原样",
    "armBattleEndHide首次成功识别有帧角色时才订阅battle:end，避免提前订阅吞核心onBattleEnd回退"
  ],
  "exactBoundaries": [
    "允许候选：game/src/battle/view/battle.frames.js + 新纯动作清单模块 + tests/battle-frames-lifecycle.test.js + 新纯清单测试；需负责人确认才写",
    "角色显式传入需额外battle.view.js仅601调用点与必要当前角色读取，不碰SYS08 preview/core",
    "不改battle.lifecycle.js、battle.anim.view.js、battle.vfx.js、battle.clock.js、battle.pace.js规则与事件"
  ],
  "tests": [
    "battle-frames-lifecycle mock仅成功idle.webp/atk-wind.webp，其余reject；当前fixture依赖旧src识别changwuyu",
    "测试不直接断言31总候选或MAX_PROBE，但断言并行>1且<=3、pending first batch inFlight=3，显式清单仍至少3候选可保留",
    "卸载partial缺idle、hide后reload、releaseGate阻止新load、同步hide/失败restore、late DOM拒绝必须保留",
    "新增清单契约：每个声明路径存在，数组顺序idle→idle-1→idle-breathe、动作槽数12/12/15，未知role不load，失败个别帧只过滤不重排；声明并不要求重复槽字节不同",
    "新增动作时间轴测试才可证明缺帧总时长均分、atk两段顺序、中断resume；当前lifecycle测试没有验证这些",
    "scripts/perf-ledger-capture.mjs:310消费sdt:battle-frames-role measure名，保留名和frames/ready字段，不用测量调用开销作FPS"
  ],
  "incidental": [
