+    if (!s.busy && s.actionQueueLength === 0) {
+      await new Promise(r => setTimeout(r, 30));
+      const next = BattleSession.getSnapshot();
+      if (!next.busy && next.actionQueueLength === 0) return next;
+    }
+  }
+  throw new Error('回合未完成');
+}
