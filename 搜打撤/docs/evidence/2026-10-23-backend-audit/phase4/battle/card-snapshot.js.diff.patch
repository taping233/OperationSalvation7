--- /dev/null
+++ game/src/cards/card-snapshot.js (after phase4)
@@ -0,0 +1,10 @@
+// Compare persisted card snapshots without depending on object-key order.
+export function sameCardSnapshot(left, right) {
+  if (left === right) return true;
+  if (!left || !right || typeof left !== 'object' || typeof right !== 'object') return false;
+  if (Array.isArray(left) !== Array.isArray(right)) return false;
+  if (Array.isArray(left) && left.length !== right.length) return false;
+  const keys = Object.keys(left);
+  return keys.length === Object.keys(right).length && keys.every(key =>
+    Object.prototype.hasOwnProperty.call(right, key) && sameCardSnapshot(left[key], right[key]));
+}
