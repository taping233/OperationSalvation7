+     const limit = stack.card.type === '资源' ? bagCap() : SDT.Base.bagCap();
+     return (stack.card.type === '资源' || delta > 0) && usedSlots() + delta > limit ? `背包空间不足，整叠需 ${delta} 格` : '';
+   }
