{
  "//": "保留的渐进类型检查配置；全域实现基线由 jsconfig.runtime.json 提供，现行覆盖与严格检查边界见 docs/architecture.md。",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "checkJs": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "game/src/run/map-graph.js",
    "game/src/cards/mech-sentences.js",
    "game/src/run/encounter-selector.js",
    "game/src/cards/cards.consts.js",
    "game/src/run/map-snapshot.js",
    "game/src/hub/game.store.js",
    "game/src/hub/commands.shared.js",
    "game/src/hub/recoverable-pair.js",
    "tests/game-store-types.fixture.ts"
  ]
}
