{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "moduleSuffixes": [
      ".typecheck",
      ""
    ]
  },
  "include": [
    "game/src/**/*.js",
    "game/src/**/*.d.ts"
  ]
}
