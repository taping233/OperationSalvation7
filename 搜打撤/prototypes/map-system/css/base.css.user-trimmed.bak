/* 基础层：工业战术终端布局（侧栏/面板/卡面/战斗/场景/Hub 等） */
  /* ============================================================
   * 工业战术终端 · 基础布局与统一覆盖
   * 石墨面板、冷青导航与少量琥珀警示共同服务搜索撤离信息层。
   * ============================================================ */
  :root {
    --ink: #080b0e;            /* 页面最深阴影 */
    --bg: #080c10;             /* 页面底色 */
    --desk1: #1b252d; --desk2: #11171c;   /* 侧边栏石墨层级 */
    --panel: #151d23; --panel2: #20282e;  /* 终端面板层级 */
    --inset: #16110c;          /* 凹槽 */
    --line: #43362a; --line2: #5f4c30;
    --txt: #e9dab4; --sub: #bfae8a; --dim: #87775a;
    --amber: #e0a458; --amber-soft: #f2d9a8;
    --gold: #f0c25c; --ember: #d4593c; --ember-hi: #e8875c;
    --ok: #5aa286; --arcane: #9a7cc8;
    --serif: Georgia, "Palatino Linotype", "STZhongsong", "SimSun", serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; background: var(--ink); color: var(--txt); overflow: hidden;
    font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased; }
  ::selection { background: rgba(224,164,88,.30); }
  ::-webkit-scrollbar { width: 9px; height: 9px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #4a3a26; border-radius: 8px; border: 2px solid var(--panel); }
  ::-webkit-scrollbar-thumb:hover { background: #63502f; }
  #app { display: flex; height: 100%; }
  /* 非游戏界面（标题/退出屏/基地）隐藏左侧栏，画面更聚焦 */
  body.lobby #sidebar { display: none; }

  /* 位图图标统一尺寸 */
  .ic { width: 1.1em; height: 1.1em; vertical-align: -0.18em; }

  /* ---------------- 侧边栏终端 ---------------- */
  #sidebar { width: 300px; min-width: 300px;
    background:
      repeating-linear-gradient(92deg, rgba(0,0,0,.07) 0 2px, rgba(255,244,210,.015) 2px 3px, transparent 3px 11px),
      linear-gradient(180deg, var(--desk1), var(--desk2));
    border-right: 1px solid #0d0a07;
    box-shadow: inset -1px 0 0 rgba(224,164,88,.10), inset -8px 0 18px -12px rgba(0,0,0,.8);
    display: flex; flex-direction: column; padding: 16px 14px; gap: 12px; overflow-y: auto; }
  #sidebar header { padding: 2px 4px 13px; position: relative; flex-shrink: 0; }
  #sidebar header::after { content: ''; position: absolute; left: 4px; right: 4px; bottom: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(224,164,88,.65), transparent); }
  #sidebar header h1 { font-size: 21px; color: #f2e6c8; letter-spacing: 2px; font-family: var(--serif);
    text-shadow: 0 1px 0 rgba(0,0,0,.6); }
  #sidebar header h1 span { font-size: 12px; color: var(--amber); font-weight: 700; margin-left: 8px;
    padding: 2px 8px; border: 1px solid rgba(224,164,88,.45); border-radius: 999px;
    background: rgba(224,164,88,.08); vertical-align: 2px; }
  #sidebar header .sub { font-size: 12px; color: var(--dim); margin-top: 6px; letter-spacing: 1px; }

  /* 石墨信息面板 */
  .panel { position: relative;
    background:
      repeating-linear-gradient(88deg, rgba(0,0,0,.045) 0 2px, transparent 2px 9px),
      linear-gradient(180deg, var(--panel2), var(--panel));
    border: 1px solid var(--line); border-radius: 10px; padding: 12px 13px;
    box-shadow: inset 0 1px 0 rgba(255,240,200,.05), inset 0 0 18px rgba(0,0,0,.18), 0 4px 14px rgba(0,0,0,.28); }
  .panel::before { content: ''; position: absolute; top: 5px; left: 8px; right: 8px; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(224,164,88,.14), transparent); pointer-events: none; }
  .panel h3 { font-size: 11px; color: #c99d58; letter-spacing: 3px; margin-bottom: 9px; font-weight: 700;
    font-family: var(--serif); display: flex; align-items: center; gap: 8px; }
  .panel h3::before, .panel h3::after { content: ''; height: 1px; flex: 1; min-width: 8px; }
  .panel h3::before { background: linear-gradient(90deg, transparent, rgba(224,164,88,.5)); }
  .panel h3::after { background: linear-gradient(90deg, rgba(224,164,88,.5), transparent); }
  .panel.grow { flex: 1; min-height: 80px; overflow: hidden; display: flex; flex-direction: column; }
  .panel.grow > :last-child { overflow-y: auto; }

  #statsPanel { display: flex; padding: 9px 4px; }
  .stat { flex: 1; text-align: center; background: none; border: none; box-shadow: none;
    border-radius: 0; padding: 2px 10px; min-width: 0; }
  .stat + .stat { border-left: 1px solid rgba(224,164,88,.16); }
  .stat label { display: block; font-size: 9.5px; color: #8a7a60; margin-bottom: 4px; letter-spacing: 2.5px; }
  .stat b { font-size: 14px; color: #f0e4c4; display: block; white-space: nowrap; overflow: hidden;
    text-overflow: ellipsis; }
  .stat b.gold { color: var(--gold); }
  .stat.stat-layer { flex: 2.1; text-align: left; padding-left: 8px; }
  .stat.stat-layer b { font-size: 12.5px; letter-spacing: 0; }

  /* 人物面板：头像 + 血条（数值内嵌）+ 经济胶囊 */
  #charPanel { padding: 13px 14px; }
  #heroRow { display: flex; align-items: center; gap: 12px; }
  .hero-ava { width: 48px; height: 48px; min-width: 48px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 21px; font-weight: 800; color: #f2d9a0; font-family: var(--serif);
    border: 1.5px solid #6a5334;
    background: radial-gradient(ellipse at 50% 30%, #46321a, #170f06 85%);
    box-shadow: inset 0 2px 8px rgba(0,0,0,.55), 0 2px 6px rgba(0,0,0,.4); }
  .hero-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .hero-top { display: flex; align-items: baseline; gap: 8px; }
  .hero-name { font-family: var(--serif); font-size: 14.5px; color: #f0e4c4; letter-spacing: 2px; }
  .hero-cls { font-size: 11px; color: var(--amber); letter-spacing: 1px; }
  .hero-cls::before { content: '// '; font-size: 10px; color: #5cb9bc; }
  .hero-cls:empty { display: none; }
  #hpBarWrap { position: relative; flex: none; height: 17px; width: 100%; background: #120d09;
    border-radius: 9px; overflow: hidden; border: 1px solid var(--line2);
    box-shadow: inset 0 2px 4px rgba(0,0,0,.5); }
  #hpBar { height: 100%; width: 100%; border-radius: 9px; position: relative; overflow: hidden;
    background: linear-gradient(90deg, #4e8a52, #6fae6e);
    transition: width .35s cubic-bezier(.22,1,.36,1), background .3s; }
  #hpBar::after { content: ''; position: absolute; inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgba(255,240,200,.30) 50%, transparent 70%);
    transform: translateX(-100%); animation: hpShine 2.8s ease-in-out infinite; }
  @keyframes hpShine { 0%, 55% { transform: translateX(-100%); } 80%, 100% { transform: translateX(100%); } }
  #hpBarWrap.low { animation: hpLow 1s ease-in-out infinite; }
  @keyframes hpLow { 0%, 100% { box-shadow: 0 0 0 rgba(212,89,60,0); }
    50% { box-shadow: 0 0 12px rgba(212,89,60,.55); border-color: #a04038; } }
  #hpText { position: absolute; inset: 0; text-align: center; line-height: 17px; font-size: 11px;
    font-weight: 700; color: #fff; text-shadow: 0 1px 2px rgba(0,0,0,.85); min-width: 0;
    pointer-events: none; }
  #charRow { display: flex; gap: 8px; align-items: stretch; }
  .chip-mini { flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px;
    font-size: 12px; color: var(--sub); border: 1px solid var(--line); border-radius: 8px;
    padding: 5px 0; background: rgba(0,0,0,.18); box-shadow: inset 0 1px 3px rgba(0,0,0,.25); }
  .chip-mini .ic { width: 14px; height: 14px; vertical-align: -0.2em; }
  .chip-mini b { color: #f0e4c4; font-size: 13.5px; }
  #charRow .chip-mini:first-child b { color: var(--gold); }
  #charRow .chip-mini:nth-child(2) b { color: #e8875c; }
  #bagBtn { flex: 1.35; padding: 7px 8px; font-size: 12px; border-radius: 8px; border: 1px solid rgba(240,194,92,.7);
    background: linear-gradient(180deg, #654515, #332209); color: #fff0c2; cursor: pointer; transition: all .15s;
    box-shadow: inset 0 1px 0 rgba(255,240,200,.16), 0 0 12px rgba(224,164,88,.16), 0 2px 5px rgba(0,0,0,.3); white-space: nowrap; }
  #bagBtn:hover { border-color: rgba(224,164,88,.65); color: var(--amber-soft); transform: translateY(-1px);
    box-shadow: 0 3px 10px rgba(0,0,0,.35); }
  #bagBtn:active { transform: scale(.96); }
  #bagBtn b { color: var(--amber); }
  #bagBtn .bag-label { font-family: var(--serif); font-weight: 800; letter-spacing: 1px; color: #ffe7aa; }

  /* 数值变化弹跳 */
  .popnum { display: inline-block; animation: popIn .32s cubic-bezier(.34,1.56,.64,1); }
  @keyframes popIn { 0% { transform: scale(.5); } 60% { transform: scale(1.25); } 100% { transform: scale(1); } }

  /* 背包 4×4 网格 */
  .bag-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 6px; }
  .bag-slot { aspect-ratio: 1; border: 1.5px dashed #4a3e2e; border-radius: 8px; position: relative;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    font-size: 10.5px; padding: 3px; text-align: center; overflow: hidden; line-height: 1.25; }
  .bag-slot.filled { border-style: solid; background: #261e14; box-shadow: inset 0 1px 0 rgba(255,240,200,.04); }
  .bag-slot.filled b { color: #ead9b5; font-weight: 600; max-width: 100%; overflow: hidden;
    text-overflow: ellipsis; }
  .bag-slot.filled span { color: var(--gold); font-size: 10px; }
  .bag-slot.filled .tier { position: absolute; top: 2px; left: 2px; transform: scale(0.85); }
  #overlay .card.bag-modal { width: min(1040px, 96%); max-height: 94vh; overflow-y: auto; text-align: left; }
  #overlay .card.bag-modal > h2 { text-align: center; }
  .bag-view .bag-grid { grid-template-columns: repeat(auto-fill, minmax(58px, 74px)); gap: 6px;
    overflow: visible; max-height: none; align-items: start; }
  .bag-view .bag-slot { min-width: 0; aspect-ratio: 10 / 14; border-radius: 7px; padding: 2px; }
  .bag-view .bag-slot:not(.card-slot):not(.safe-slot) { aspect-ratio: 10 / 14; }
  .bag-view .bag-slot .hs-card { width: 10em; height: 14em; font-size: clamp(5px, .56vw, 7px);
    max-width: 100%; max-height: 100%; box-shadow: 0 2px 5px rgba(0,0,0,.5); }
  .bag-view .bag-slot .flip-face { display: flex; align-items: center; justify-content: center; }
  .bag-view .bag-slot .stack-count { position: absolute; right: 2px; bottom: 2px; z-index: 5;
    min-width: 20px; padding: 1px 4px; border-radius: 999px; color: #fff1bd; background: rgba(18,11,4,.9);
    border: 1px solid rgba(240,194,92,.65); font-size: 9px; font-weight: 800; }
  .bag-card-detail { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .bag-card-detail .hs-card { font-size: min(22px, 2.5vh); }
  .bag-drop-note { text-align: center; color: #d0bd94; font-size: 12px; margin: 8px 0; }
  .tier-bd-S { border-color: #f0c25c; }
  .tier-bd-A { border-color: #9a7cc8; }
  .tier-bd-B { border-color: #6a9ec2; }
  .tier-bd-C { border-color: #7a6e5a; }
  .tier-bd-EV { border-color: #4e9e8a; }
