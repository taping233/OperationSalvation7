{
  "name": "codename7-soudache",
  "productName": "搜打撤·代号7",
  "version": "0.51.0",
  "description": "搜打撤 · 代号7 桌面版",
  "main": "main.js",
  "author": "taping",
  "scripts": {
    "check:version": "node ../scripts/check-version.cjs",
    "check:runtime": "node check-electron-runtime.cjs",
    "prestart": "npm run build:game && npm run check:runtime && npm run check:version",
    "start": "electron .",
    "predist": "npm run check:runtime && npm run check:version",
    "dist": "npm run build:game && node build-portable.cjs",
    "build:game": "npm run build --prefix .."
  },
  "devDependencies": {
    "electron": "44.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.taping.codename7",
    "productName": "搜打撤·代号7",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "game",
        "to": "game"
      }
    ],
    "win": {
      "icon": "app.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "搜打撤-代号7.exe"
    }
  }
}
