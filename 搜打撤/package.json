{
  "name": "codename7-soudache-game",
  "private": true,
  "version": "0.60.0",
  "license": "MIT",
  "type": "module",
  "description": "搜打撤 · 代号7 游戏源码（Vite + Vitest）",
  "scripts": {
    "narrative:compile": "node scripts/compile-narrative.mjs",
    "predev": "npm run narrative:compile",
    "dev": "vite",
    "web": "node scripts/web-up.mjs",
    "prebuild": "npm run narrative:compile && node scripts/validate-data.mjs",
    "build": "vite build",
    "postbuild": "node scripts/perf-budget.cjs",
    "preview": "vite preview",
    "pretest": "npm run narrative:compile && node scripts/validate-data.mjs",
    "test": "vitest run",
    "test:changed": "node scripts/test-changed.mjs",
    "test:target": "node scripts/acceptance-gate.mjs --target-tests",
    "check:staged": "node scripts/acceptance-gate.mjs --staged --run",
    "check:staged:plan": "node scripts/acceptance-gate.mjs --staged --plan",
    "check:syntax": "node scripts/check-syntax.mjs",
    "typecheck": "node scripts/check-types.mjs",
    "lint": "eslint game/src game/tools tests scripts \"*config.{js,mjs,cjs}\"",
    "check:quality": "npm run check:syntax && npm run validate:data && npm run typecheck && npm run lint && npm test && npm run build",
    "test:watch": "vitest",
    "handoff": "node scripts/handoff-brief.mjs",
    "workflow": "node scripts/workflow.mjs",
    "check:staged:isolate": "node scripts/workflow.mjs staged --task staged-check",
    "docs:check": "node scripts/workflow.mjs docs",
    "memory:discover": "node scripts/workflow.mjs memory",
    "docs:retire": "node scripts/doc-retirement-candidates.mjs",
    "perf": "node scripts/perf-benchmark.cjs",
    "perf:soak": "node scripts/perf-benchmark.cjs --soak",
    "perf:budget": "node scripts/perf-budget.cjs",
    "assets:audit": "node scripts/asset-audit.cjs",
    "sfx:gen": "node game/scripts/jsfxr-generate.cjs",
    "cards:sync": "node scripts/sync-cards-from-live.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "docs:compendium": "vitest run tests/compendium.test.js",
    "jscpd:baseline": "jscpd --reporters json --output node_modules/.cache/jscpd game/css game/src scripts",
    "impact": "node scripts/impact-query.mjs",
    "quality:property": "vitest run --config tests/tools/quality.vitest.config.mjs",
    "quality:mutation": "stryker run stryker.config.json",
    "quality:unused": "knip --config tests/tools/knip.report.json --reporter json",
    "quality:axe-dom": "node tests/tools/axe-dom-audit.mjs",
    "quality:styles": "stylelint \"game/css/{secondary-ui-tokens,bag-design-system,container-store,card-browser,ui-design-system}.css\"",
    "quality:styles:test": "node --test tests/tools/ui-style-contract.test.mjs",
    "quality:clones": "node tests/tools/redundancy-audit.mjs",
    "quality:clones:test": "node --test tests/tools/redundancy-contract.test.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "axe-core": "4.14.0",
    "eslint": "^10.11.0",
    "fast-check": "4.10.2",
    "jscpd": "5.4.1",
    "jsdom": "^25.0.1",
    "jsfxr": "^1.4.1",
    "knip": "6.42.0",
    "postcss": "8.5.28",
    "stylelint": "17.16.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "inkjs": "^2.4.0",
    "motion": "^13.2.0",
    "pixi.js": "^7.4.3",
    "pixi.js-legacy": "7.4.3"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "typed-rest-client": "2.3.0"
    }
  }
}
