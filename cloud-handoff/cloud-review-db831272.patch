+// ---------- 执行器：turbo 管理 / console.error 捕获 / 报告装配（防重入由轻量门面持有） ----------
+async function executeScene(name, options = {}) {
+  const def = SCENE_CATALOG[name];
+  if (!Object.hasOwn(SCENE_RUNNERS, name)) {
+    return { ok: false, pass: false, code: 'UNKNOWN_SCENE',
